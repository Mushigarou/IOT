NODE_NAME = "k3d"
NODE_IP   = "192.168.56.115"

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"
  config.vm.box_check_update = false

  config.vm.define NODE_NAME do |node|
    node.vm.hostname = NODE_NAME
    node.vm.network "private_network", ip: NODE_IP
    # Argo CD UI and the deployed app, both published by the k3d load balancer.
    node.vm.network "forwarded_port", host: 8080, guest: 8080
    node.vm.network "forwarded_port", host: 10000, guest: 10000
    node.vm.synced_folder ".", "/vagrant", disabled: true

    node.vm.provider "virtualbox" do |v|
      v.name = NODE_NAME
      v.memory = 4096
      v.cpus = 4
    end

    node.vm.provision "shell", name: "install tools", path: "scripts/init.sh"
    node.vm.provision "file", source: "confs/.", destination: "/home/vagrant/confs"
    node.vm.provision "shell", name: "deploy apps", path: "scripts/deploy.sh"
  end
end
